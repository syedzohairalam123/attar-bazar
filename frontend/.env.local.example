# ═══════════════════════════════════════════════════════════
# Attar Bazaar — Environment Variables Template
# Copy this file to ".env.local" (same folder) and fill in your
# real values. ".env.local" is git-ignored and read automatically
# by Next.js — restart "npm run dev" after editing it.
# ═══════════════════════════════════════════════════════════

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — Nodemailer + SMTP. For Gmail:
# 1. myaccount.google.com/security -> turn ON 2-Step Verification
# 2. myaccount.google.com/apppasswords -> create an App Password for "Mail"
# 3. Paste the 16-character code below as SMTP_PASSWORD (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Attar Bazaar
ADMIN_EMAIL=your-email@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=your-email@gmail.com

SUPABASE_WEBHOOK_SECRET=change-this-to-a-random-string
NEXT_PUBLIC_APP_NAME=Attar Bazaar
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
